HOST=127.0.0.1
PORT=4080
PUBLIC_URL=http://localhost:4080
DATABASE_URL=postgresql://community:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/community
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_KEY=REPLACE_WITH_64_HEX_CHARACTERS
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_CHARACTER_PASSWORD
INITIAL_ADMIN_NAME=Administrator
TRUST_PROXY=0
# One named cloud. Credentials stay on the server. Example: secrets/clouds.yaml
HEAT_DRIVER=openstack
OPENSTACK_CLOUDS_YAML=./secrets/clouds.yaml
OPENSTACK_CLOUD_NAME=community
OPENSTACK_SERVICE_PROJECT_NAME=admin
OPENSTACK_INTERFACE=public
OPENSTACK_PREFER_INTERNAL_ENDPOINTS=0
# OPENSTACK_CA_CERT=./secrets/openstack-ca.crt
# Resource SSH keys stay in this deployment's /app/data/known_hosts.
SSH_KNOWN_HOSTS_SCOPE=resource
# Optional, deployment-specific public routing. Connect exported proxy maps yourself.
LAB_BASE_DOMAIN=apps.example.com
SSH_PUBLIC_HOST=
# Optional SSH ingress: no deployment host is allowed by default. Example: 192.0.2.10/32
COMMUNITY_SSH_SOURCE_CIDRS=
# Optional VM lifecycle check: name/ID of the OpenStack network selected by the operator.
COMMUNITY_VALIDATION_NETWORK=
# Optional: container registry search/mirroring and CAPO image repository.
CONTAINER_REGISTRY_SEARCH_URL=
CONTAINER_REGISTRY_PUBLIC_HOST=
CAPO_IMAGE_REPOSITORY=registry.k8s.io
# Optional services require deployment-specific network ranges; no ranges are selected automatically.
CAPO_POD_CIDR=
CAPO_SERVICE_CIDR=
METALLB_VIP_POOL_CIDR=
